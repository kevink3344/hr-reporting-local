PORT=3000

# Data source: fixtures (default, no DB needed) | mysql | turso
# mysql  -> live MariaDB reporting DB (requires DB_* below)
# turso  -> synthetic SQLite dev replica (requires TURSO_* below)
DATA_SOURCE=fixtures

# MariaDB / MySQL reporting database (fill these in locally; keep secrets out of git)
DB_HOST=your-db-host.example.com
DB_PORT=3306
DB_NAME=reporting
DB_USER=reporting_readonly
DB_PASSWORD=your-db-password
DB_SSL=disabled

# Turso / libSQL dev replica (synthetic data; docs/data/turso/*.sql)
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_API_KEY=your-api-key

# System Information baseline (admin-only page). The server writes its own
# day-over-day snapshot here, since the reporting DB keeps no load history.
# Default: <app root>/docs/data/daily-refresh/system-info-snapshot.json
# Recommended on a server: a persistent path OUTSIDE the app checkout, so a
# redeploy or a read-only checkout cannot reset the baseline. The directory is
# created on demand, and the process user needs write access to it.
# SYSTEM_INFO_SNAPSHOT=/var/lib/hr-reporting/system-info-snapshot.json
