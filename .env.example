PORT=3000

# Data source: fixtures (default, no DB needed) | mysql | turso
# mysql  -> live MariaDB reporting DB (requires DB_* below)
# turso  -> synthetic SQLite dev replica (requires TURSO_* below)
DATA_SOURCE=fixtures

# MariaDB / MySQL reporting database (fill these in locally; keep secrets out of git)
DB_HOST=your-db-host.example.com
DB_PORT=3306
DB_NAME=reporting
DB_USER=reporting_readonly
DB_PASSWORD=your-db-password
DB_SSL=disabled

# Turso / libSQL dev replica (synthetic data; docs/data/turso/*.sql)
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_API_KEY=your-api-key
