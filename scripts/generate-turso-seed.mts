    `cert_areas, license_expiration, nbpts_expire, years_of_serv, months_of_serv) VALUES (` +
    `${p.id}, ${esc(empNo)}, ${esc(p.first)}, ${esc('')}, ${esc(p.last)}, ${esc(fullName)}, ${esc(email)}, ${esc(`${p.first.toLowerCase()}.personal@example.test`)}, ` +
    `${esc(p.org)}, ${esc(p.role)}, ${esc(String(p.pos))}, ${esc(String(p.pos))}, ${esc(classroomVal)}, ${esc('0901')}, ${esc('120')}, ${esc('01.0000.000.000.0001')}, ` +
    `${esc('Y')}, ${esc('Active')}, ${esc('A-' + empNo)}, ${esc('Instructional Staff')}, ${esc(p.qual + ' Staff')}, ${esc(p.qual)}, ${10}, ${tapValue}, ${esc('MS-' + p.id % 999)}, ` +
    `${esc(p.id % 2 === 0 ? 'F' : 'M')}, ${esc('Not specified')}, ${dob}, ${esc(p.role)}, ${esc(tenureCodeVal)}, ${esc(tenureDescVal)}, ` +
    `${esc('S')}, ${esc('Employee')}, ${esc('Central')}, ${esc('Principal ' + p.org.toUpperCase())}, ${esc('Standard')}, ` +
    `${esc('Monthly')}, ${step}, ${salary}, 0, ${esc('N')}, 0, 0, 40, ` +
    `${p.id % 3 === 0 ? 1500 : 0}, ${p.id % 4 === 0 ? 1000 : 0}, ${esc(hireDate)}, ${esc(hireDate)}, ${renewalStart}, ${esc('2026-08-31')}, ${contractTypeColVal}, ${contractIdValue}, ` +
    `${esc('2026-08-01')}, ${contractEndValue}, ${esc('2026-07-01')}, ${esc('2027-06-30')}, ${esc('Annual update')}, ${esc('BOARD-' + p.id)}, ${esc('Regular')}, ` +
