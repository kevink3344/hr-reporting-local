test-*.mjs

# System Information baseline: written by the server at runtime, so it reflects
# whatever the reporting database held the last time an admin opened the page.
# Committing it would ship one machine's stale row counts as everyone's baseline.
docs/data/daily-refresh/system-info-snapshot.json

# Local editor config
.vscode/

# Throwaway output from verification runs (probe / build / typecheck dumps).
# These live at the repo root and are regenerated on demand; they are not
# source. Probe SCRIPTS under scripts/ are intentional and stay tracked.
.logs/
/_*.txt
/_*.json
/_*.html
_tsc-client.txt
