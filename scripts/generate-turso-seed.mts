// pos_start: deterministic date 10-12 years ago (2014-09-05 to 2016-09-05) so
// every position looks like it was created when the school was built.
function posStartFor(idx: number, id: number): string {
  const startMs = Date.UTC(2014, 8, 5); // 2014-09-05
  const rangeDays = 731; // inclusive range to 2016-09-05
  const offsetDays = (idx * 37 + id * 13) % rangeDays;
  const ms = startMs + offsetDays * 24 * 60 * 60 * 1000;
  const d = new Date(ms);
  const yyyy = d.getUTCFullYear();
  const mm = String(d.getUTCMonth() + 1).padStart(2, '0');
  const dd = String(d.getUTCDate()).padStart(2, '0');
  return `${yyyy}-${mm}-${dd}`;
}

