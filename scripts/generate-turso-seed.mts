// ---------------------------------------------------------------------
// Deterministic synthetic seed generator (no Math.random — repeatable).
// Produces docs/data/turso/seed.sql for the Turso/SQLite dev replica.
// All data is fake: @example.test emails, no real PII, numeric person_ids.
// ---------------------------------------------------------------------

const out = resolve(process.cwd(), 'docs', 'data', 'turso', 'seed.sql');
const lines: string[] = [];

lines.push('-- =====================================================================');
lines.push('-- HR Reporting — Turso / SQLite Development Seed (SYNTHETIC DATA)');
lines.push('-- Generated by scripts/generate-turso-seed.mts. Do not hand-edit.');
lines.push('-- No real PII: all names/emails/IDs are fabricated for offline dev/demo.');
lines.push('-- =====================================================================');
lines.push('');
lines.push('PRAGMA foreign_keys = OFF;');
lines.push('BEGIN;');
lines.push('');
// ---------------------------------------------------------------------
// Idempotent re-seeding: clear every seeded table before inserting so a
// re-run replaces the data instead of appending duplicate rows (the seed
// emits plain INSERT — without this, re-applying seed.sql duplicates rows
// such as the leave balances). Blank child tables are cleared too so a
// stale row can never survive a re-seed.
// ---------------------------------------------------------------------
for (const table of [
  'schools',
  'position_info',
  'employee_info',
  'schools_example',
  'cert_info',
  'cert_area',
  'address',
  'leaves',
  'education_info',
  'mentor',
  'resignations',
  'employee_info_future',
  'assignment',
  's_n_a'
]) {
  lines.push(`DELETE FROM ${table};`);
}
lines.push('');

const sql = (s: string) => lines.push(s);

const esc = (v: string | number | null): string => {
  if (v === null || v === undefined) return 'NULL';
  if (typeof v === 'number') return String(v);
  return `'${String(v).replace(/'/g, "''")}'`;
};

